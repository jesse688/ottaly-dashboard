# Shared Postgres (same instance as admin-legacy / scraper-service)
DATABASE_URL=postgres://user:pass@host:5432/ottaly

# Companies House API key (shared with admin-legacy — budget the 600 req/5min!)
COMPANIES_HOUSE_API_KEY=

# CH pacing for THIS process. Shared-key budget: keep headroom for admin-legacy.
# 550ms ≈ 1.8 req/s. Raise to slow down further if admin-legacy 429s.
CH_MIN_INTERVAL_MS=550

# Path to the Land Registry CCOD SQLite index (mounted volume), for the building-
# ownership step wired in a later phase. Optional for P0/P1.
CCOD_INDEX=/data/ccod-index.db

PORT=3100
