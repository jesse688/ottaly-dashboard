# Client portal environment — copy to .env and fill in. NEVER commit .env.

# ── Database ──
DATABASE_URL=postgres://user:pass@host:5432/db

# ── Auth / admin ──
PORTAL_JWT_SECRET=
PORTAL_ADMIN_KEY=
PORTAL_BASE_URL=https://login.ottaly.co.uk
ADMIN_DASH_URL=
ADMIN_DASH_KEY=
CRON_SECRET=

# ── EmailBison (Bison) ──
BISON_API_URL=
BISON_API_KEY=
BISON_WORKSPACE_ID=
BISON_WEBHOOK_SECRET=
BISON_WEBHOOK_TARGET_URL=
# Master switch for Bison REPLY INGESTION into the unibox. We've migrated to
# PlusVibe (replies arrive via the external pv-reconciler), so leave this OFF —
# Bison ingestion only creates duplicate unibox rows. Set to true to re-enable
# the Bison webhook + reconcile/sync crons. Outbound Bison API use is unaffected.
BISON_INGEST_ENABLED=false

# ── PlusVibe ──
PLUSVIBE_API_KEY=
PLUSVIBE_KEY=
PLUSVIBE_WEBHOOK_SECRET=
PLUSVIBE_WEBHOOK_TARGET_URL=

# ── Companies House (lead enrichment) ──
# Official free API key: https://developer.company-information.service.gov.uk
# Used to pull verified company facts (address, officers, SIC, status) when a
# reply is classified as interested. Without it, CH enrichment is a silent no-op.
COMPANIES_HOUSE_API_KEY=

# ── Contacts store (enrichment source) ──
CONTACTS_WORKSPACE=ottaly-global

# ── Email / notifications ──
RESEND_API_KEY=
EMAIL_FROM=
INTERESTED_ALERT_EMAIL=
LEAD_NOTIFY_BCC=

# ── Slack notifications ──
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ── AI classification ──
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
FEWSHOT_ENABLED=
