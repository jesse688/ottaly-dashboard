# Same Postgres the dashboard uses (Easypanel internal host).
DATABASE_URL=postgres://postgres:PASSWORD@ottaly_ottaly-postgres:5432/ottaly?sslmode=disable

# Rotating proxies: comma-separated host:port:user:pass
PROXY_LIST=

# AI classification (business type / industry / keywords).
# Leave ANTHROPIC_API_KEY blank to disable — those fields just stay empty.
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-4-5-20251001

# Tuning
MAX_CONCURRENCY=50        # concurrent page fetches inside a scrape batch
BATCH_SIZE=100            # job items processed per loop (progress granularity)
DISCOVERY_CONCURRENCY=10  # concurrent domain-discovery probes
ENRICH_CONCURRENCY=6      # concurrent classify calls per batch
IDLE_POLL_MS=5000         # how often to poll for new queued jobs
