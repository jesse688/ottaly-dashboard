# Same Postgres the dashboard uses (Easypanel internal host).
DATABASE_URL=postgres://postgres:PASSWORD@ottaly_ottaly-postgres:5432/ottaly?sslmode=disable

# Rotating proxies. Use ONE, in order of preference:
#   WEBSHARE_API_KEY — Webshare API token (Dashboard → API). PREFERRED: never
#                      expires (unlike the download-link token). Worker pulls the
#                      full list via the API on startup.
#   PROXY_LIST_URL   — a download URL. NOTE: Webshare download tokens expire and
#                      then return JSON errors → no proxies. Avoid if possible.
#   PROXY_LIST       — manual comma-separated host:port:user:pass entries.
# These are HTTP proxies for WEB SCRAPING — separate from the SOCKS5 proxies
# Reacher/SMTP verification use. Don't reuse SMTP proxies here.
WEBSHARE_API_KEY=
PROXY_LIST_URL=
PROXY_LIST=

# Website discovery for companies with no stored domain. Without SEARXNG_URL the
# worker can only guess domains from the company name (low hit rate). Point this
# at the same self-hosted SearXNG admin-legacy uses. Gemini (GEMINI_API_KEY,
# below) is the fallback. Mojeek is the only consistently-working engine on a
# datacenter IP; bing is a best-effort second.
SEARXNG_URL=https://ottaly-searxng.oix3xv.easypanel.host
SEARXNG_ENGINES=mojeek,bing

# AI classification (business type / industry / keywords).
# Set ONE provider key. If both are set, Gemini wins (override with
# CLASSIFY_PROVIDER=claude|gemini). Leave both blank to disable — those
# fields just stay empty; everything else still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-4-5-20251001
# CLASSIFY_PROVIDER=gemini

# Playwright fallback: retry blocked/JS-only sites with a real Chromium browser
# (runs JS, passes most anti-bot walls). Needs the Playwright Docker image +
# a container with >=2GB RAM. Off by default. Set to 1 to enable.
PLAYWRIGHT_FALLBACK=
PLAYWRIGHT_CONCURRENCY=2   # browser pages at once — keep low, Chromium is heavy

# Tuning
MAX_CONCURRENCY=50        # concurrent page fetches inside a scrape batch
BATCH_SIZE=100            # job items processed per loop (progress granularity)
DISCOVERY_CONCURRENCY=10  # concurrent domain-discovery probes
ENRICH_CONCURRENCY=6      # concurrent classify calls per batch
IDLE_POLL_MS=5000         # how often to poll for new queued jobs
