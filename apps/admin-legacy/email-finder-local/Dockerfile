FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --omit=dev

COPY server.js ./
COPY public ./public
COPY README.md ./

ENV PORT=5050
ENV SOCKS5_HOST=
ENV SOCKS5_PORT=1081
ENV SOCKS5_USER=
ENV SOCKS5_PASS=
ENV SMTP_TIMEOUT_MS=5000
ENV CHECK_DELAY_MS=0
ENV MAX_CANDIDATES=12
ENV VERIFY_CANDIDATES=12
ENV ROW_CONCURRENCY=15
ENV CANDIDATE_CONCURRENCY=8
ENV MAX_CONTACTS=10000

EXPOSE 5050

CMD ["node", "server.js"]
